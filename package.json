{
  "name": "commandui",
  "private": true,
  "version": "1.0.2",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm --filter @commandui/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "verify": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"],
    "overrides": {
      "vitest": ">=3.2.6 <4",
      "vite": ">=6.4.3 <7",
      "picomatch": ">=4.0.4 <5",
      "ws": ">=8.21.0 <9",
      "postcss": ">=8.5.18 <9",
      "nanoid": ">=3.3.18 <4",
      "browserslist": ">=4.28.7 <5"
    }
  }
}
